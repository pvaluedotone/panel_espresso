# Environment variables for Panel Espresso deployment
# Copy this file to .env and customize for your deployment

# Server Configuration
# For local development, these use default values
# For Cloud Run, these are automatically set
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=8080

# Optional: Set this if deploying to Cloud Run
# Cloud Run automatically sets PORT, so this may not be needed
# PORT=8080

# Optional: Additional configuration
# Add any custom environment variables your application needs here
